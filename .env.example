# Copie este archivo como .env y complete los valores. El .env NUNCA se sube al repositorio.

# --- Aplicación ---
APP_NOMBRE=VoluntaCR
# true solo en desarrollo: muestra el detalle de los errores
APP_DEBUG=false
# true para la demo: muestra qué motor resolvió cada reserva y cuánto tardó
APP_MODO_DEMO=true
# Subcarpeta si el sitio no está en la raíz del dominio (ej. /voluntacr). Vacío si está en la raíz.
APP_BASE=
APP_ZONA_HORARIA=America/Costa_Rica
APP_REPOSITORIO=https://github.com/41varado/voluntary-hub
# Dirección pública del sitio, sin la subcarpeta de APP_BASE. Se usa en los enlaces de los correos.
APP_URL=http://localhost:8080

# --- MongoDB (motor principal) ---
# La URI solo se escribe aquí: la leen la aplicación, los scripts de PHP y scripts/mongosh/crear_esquema.js.
# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=voluntacr
MONGO_TIMEOUT_MS=2500

# --- Redis (acelerador; si falla, la aplicación sigue con MongoDB) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Obligatorio en el Redis compartido del curso: cambie X por el número de su grupo
REDIS_PREFIX=grupoX:voluntacr:
# Segundos que se espera a Redis antes de pasar a modo respaldo
REDIS_TIMEOUT=0.5
# Segundos sin reintentar después de una falla
REDIS_REINTENTO_SEG=30
# true para simular que Redis no existe (pruebas y mediciones)
REDIS_DESHABILITADO=false

# --- Correo con Mailjet (confirmación del correo y avisos) ---
# Claves en Mailjet: Account settings > API Key Management (la secreta se muestra una sola vez).
# Si quedan vacías, ningún correo sale: se anotan en storage/correos.log y la página de confirmación
# muestra el enlace (solo para desarrollo).
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Remitente validado en Mailjet (Account settings > Senders & Domains)
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=VoluntaCR
# Segundos que se espera a Mailjet antes de dejar el correo para el reintento
MAILJET_TIMEOUT=5

# --- Sesiones ---
# Cada cuántos segundos se revisa que la cuenta siga activa (desactivar o restablecer la clave cierra la sesión)
SESION_VERIFICAR_SEG=60

# --- Reglas del negocio ---
# Minutos para confirmar una reserva antes de que el cupo se libere
RESERVA_MINUTOS=10
# Segundos que dura en caché el listado de actividades
CACHE_TTL_SEG=60
# Tamaño máximo por imagen subida
SUBIDAS_MAX_MB=2
